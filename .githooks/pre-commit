#!/bin/sh
# MongAI pre-commit フック：秘密情報のコミットを防ぐ。
#   - .env をコミットしない
#   - .env.example の OITOMA_API_KEY 等に値を入れたままコミットしない
#   - data/private/ 以下をコミットしない

set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)

fail() {
    echo "pre-commit: コミットを拒否しました：$1" >&2
    exit 1
}

for f in $staged; do
    case "$f" in
        .env | .env.local | */.env) fail "$f は秘密情報を含むためコミットできません" ;;
        data/private/*) fail "$f（data/private/ 以下）はコミットできません" ;;
    esac
done

if printf '%s\n' "$staged" | grep -qx '.env.example'; then
    # 値は表示しない
    if git show :.env.example | grep -E -q '^[[:space:]]*[A-Z_]*(API_KEY|SECRET|TOKEN|PASSWORD)[A-Z_]*[[:space:]]*=[[:space:]]*[^[:space:]#]'; then
        fail ".env.example に APIキー等の値が入っています。値は .env に書き、.env.example は空欄にしてください"
    fi
fi

exit 0
