  {
   "paragraph_id": "P-0004",
   "section_id": "SEC-01",
   "kind": "heading",
   "lang": "ja",
   "text": "概要",
   "page": 1,
   "bboxes": [
    {
     "page": 1,
     "x0": 72.0,
