# SI-NSA の環境変数。`cp .env.example .env` してから値を記入する。
# .env は .gitignore 済み。実値をコミットしないこと。

# おいとまAPI のキー（core / worker / gateway にだけ渡される）
OITOMA_API_KEY=

# おいとまAPI のベースURL（通常は変更不要）
OITOMA_BASE_URL=https://ironical.okayama-u.ac.jp/ai/v1

# 同時に実行する解析の数（既定 2）。変更後は worker の再起動が必要
MONGAI_MAX_JOBS=2

# ---- Google でのログイン（docs/auth-setup.md）。authn にだけ渡される ----
# Google Cloud で作った OAuth クライアント（ウェブ アプリケーション）の ID とシークレット。
# 未設定ならログインできず、全員がゲスト（共通デモの閲覧だけ）になる
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud に登録した「承認済みのリダイレクト URI」と完全に同じ値（localhost と 127.0.0.1 は別物）。
# 既定は http://localhost:8080/auth/callback（ブラウザでは http://localhost:8080 を開く）
GOOGLE_OAUTH_REDIRECT_URI=
# ログインを許可するメールのドメイン（カンマ区切り。そのサブドメインも許可する）。既定は okayama-u.ac.jp
MONGAI_ALLOWED_EMAIL_DOMAINS=
# ログインのセッションの期間（時間。既定 8）と、操作しないと切れるまでの時間（分。既定 120）
MONGAI_SESSION_HOURS=
MONGAI_SESSION_IDLE_MINUTES=

# 学内のHTTPプロキシ経由でイメージをビルドする場合だけ設定する。
# ビルド引数としてのみ使われ、実行時のコンテナには渡さない。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
